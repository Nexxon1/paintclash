{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Scenario-test-only view of the server (spec §9.1): same Worker + Arena-DO,
  // but without the static-assets binding, so the tests are hermetic — they
  // never depend on a built client. Never deployed.
  "name": "paintclash-scenario",
  "main": "../../packages/server/src/index.ts",
  "compatibility_date": "2026-07-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "ARENA",
        "class_name": "ArenaDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      // SQLite-backed: the only DO flavor available on the Free plan (ADR-0001).
      "new_sqlite_classes": ["ArenaDO"],
    },
  ],
  // Top level = the arena as production runs it, bots included (spec §2.7) —
  // used by `bots.test.ts` through `vitest.bots.config.ts`.
  "vars": {
    "COMMIT_SHA": "scenario",
    // Pinned RNG seed ⇒ FIXED spawns (start blocks and headings). The scenario
    // choreographies have to fly real heads into the state a rule needs — with
    // random spawns that setup is a probabilistic maneuver that mostly works,
    // which is exactly how a suite ends up red on a shared CI runner every few
    // tickets. Pinned, a choreography that works works every run, and one that
    // does not fails locally too, where it can be fixed.
    "ARENA_SEED": "20260730",
    // ARENA_BOTS deliberately unset here = the balanced bot target.
  },

  // Everything EXCEPT bots.test.ts runs here (see `vitest.config.ts`): the same
  // worker with the population switched off. Same reason the seed is pinned —
  // each choreography flies specific heads into a specific state, and seven
  // extra entities painting, stealing and killing through the scene would turn
  // every one of them into a maneuver that mostly works.
  //
  // Wrangler inherits neither `vars` nor `durable_objects` into a named
  // environment, so both are restated in full.
  "env": {
    "hermetic": {
      "durable_objects": {
        "bindings": [
          {
            "name": "ARENA",
            "class_name": "ArenaDO",
          },
        ],
      },
      "vars": {
        "COMMIT_SHA": "scenario",
        "ARENA_SEED": "20260730",
        "ARENA_BOTS": "0",
      },
    },
  },
}
