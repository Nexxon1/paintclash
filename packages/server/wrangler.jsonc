{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paintclash",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // Static Assets serve the built client (run `pnpm --filter @paintclash/client
  // build` first); the Worker sits in front for the API and routes WebSockets
  // to the Arena Durable Object.
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ARENA",
        "class_name": "ArenaDO",
      },
      {
        // Per-IP room-creation budget (spec §8.3 point 6) — one object at a
        // fixed name, see `room-gate-do.ts`.
        "name": "ROOM_GATE",
        "class_name": "RoomGateDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      // SQLite-backed: the only DO flavor available on the Free plan (ADR-0001).
      "new_sqlite_classes": ["ArenaDO"],
    },
    {
      // Private rooms (ticket 14): the room-creation rate limiter.
      "tag": "v2",
      "new_sqlite_classes": ["RoomGateDO"],
    },
  ],
  "vars": {
    // Overridden per deploy with the real git SHA via `--var COMMIT_SHA:<sha>`;
    // `dev` is the fallback for `wrangler dev` / dry-runs.
    "COMMIT_SHA": "dev",
    // Optional dev-only override: `wrangler dev --var ARENA_SIZE_WU:50` runs a
    // small arena for fast local mechanics testing (root script `dev:small`).
    // Deliberately NOT set here — deploys always play the BALANCE size.
  },
  "observability": {
    "enabled": true,
  },
}
